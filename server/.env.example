# server/.env.example
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5174
NODE_ENV=production
HOST=0.0.0.0

# CORS Origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://kireiryokaku.github.io,https://yourusername.github.io

# Calendar Configuration
CALENDAR_ICS_URL=https://your-calendar-url.ics

# Google Sheets API (Base64 encoded credentials)
CLIENT_EMAIL=your-service@your-project.iam.gserviceaccount.com
PRIVATE_KEY_BASE64=your_base64_encoded_private_key_here
SHEETS_ID=your_google_sheets_id

# Email Configuration
# Set EMAIL_PROVIDER=gmail for Gmail API delivery, or smtp for SMTP.
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
# SMTP settings are used only when EMAIL_PROVIDER=smtp (or is unset).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDER_EMAIL=your-email@gmail.com
REPLY_TO=your-email@gmail.com
ADMIN_EMAIL=admin@example.com
# Recipient for Anelia's consultation inquiries (defaults to sunzatebe@gmail.com)
ANELIA_CONTACT_EMAIL=sunzatebe@gmail.com